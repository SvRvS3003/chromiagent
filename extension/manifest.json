{
  "manifest_version": 3,
  "name": "Chromiagent",
  "version": "1.8.0",
  "description": "Agent side panel for Chromium browsers: a real terminal and an AI agent that sees and drives every open tab.",
  "key": "",
  "permissions": [
    "sidePanel",
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "storage"
  ],
  "action": {
    "default_title": "Ask Agent",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A",
        "windows": "Alt+A",
        "linux": "Alt+A"
      },
      "description": "Open Chromiagent"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:17371"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
